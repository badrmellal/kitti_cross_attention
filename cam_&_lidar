{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.12","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":2255937,"datasetId":1357458,"databundleVersionId":2296912}],"dockerImageVersionId":31328,"isInternetEnabled":false,"language":"python","sourceType":"notebook","isGpuEnabled":true}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"markdown","source":"# Multimodal Contrastive Learning with Cross-Attention Fusion\n\n- RGB camera + LiDAR (BEV).\n- Fuses them with **cross-modal attention** inside the encoder: image tokens attend to BEV tokens and vice versa.\n- Trains with **SimCLR NT-Xent** loss: two augmented views of the same frame are pulled together, different frames pushed apart.","metadata":{}},{"cell_type":"code","source":"import os, glob, random, math\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import Dataset, DataLoader\nfrom PIL import Image, ImageEnhance, ImageFilter\nimport matplotlib.pyplot as plt\nfrom sklearn.decomposition import PCA\nfrom sklearn.manifold import TSNE\nfrom tqdm.auto import tqdm\n\nSEED = 42\nrandom.seed(SEED); np.random.seed(SEED); torch.manual_seed(SEED)\n\nDEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint('device:', DEVICE)\n\nIMG_PATHS = sorted(glob.glob('/kaggle/input/**/*.png', recursive=True))\nBIN_PATHS = sorted(glob.glob('/kaggle/input/**/*.bin', recursive=True))\n\n# match by stem\nimg_by_stem = {os.path.splitext(os.path.basename(p))[0]: p for p in IMG_PATHS}\nbin_by_stem = {os.path.splitext(os.path.basename(p))[0]: p for p in BIN_PATHS}\ncommon = sorted(set(img_by_stem) & set(bin_by_stem))\n\nN_SAMPLES = min(5000, len(common))   # raise this number or make fewer samples\ncommon = common[:N_SAMPLES]\nIMG_LIST = [img_by_stem[s] for s in common]\nBIN_LIST = [bin_by_stem[s] for s in common]\nprint(f'matched frames: {len(common)}  (using {N_SAMPLES})')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-27T21:30:37.719339Z","iopub.execute_input":"2026-04-27T21:30:37.719795Z","iopub.status.idle":"2026-04-27T21:35:08.633184Z","shell.execute_reply.started":"2026-04-27T21:30:37.719765Z","shell.execute_reply":"2026-04-27T21:35:08.632441Z"}},"outputs":[{"name":"stdout","text":"device: cuda\nmatched frames: 5000  (using 5000)\n","output_type":"stream"}],"execution_count":3},{"cell_type":"markdown","source":"**Data processing**","metadata":{}},{"cell_type":"code","source":"IMG_H, IMG_W = 96, 320\nBEV_H, BEV_W = 96, 96\n\ndef load_image(path):\n    return np.asarray(\n        Image.open(path).convert('RGB').resize((IMG_W, IMG_H), Image.BILINEAR),\n        dtype=np.float32) / 255.0\n\ndef load_bev(path, H=BEV_H, W=BEV_W,\n             x_range=(0, 50), y_range=(-25, 25), max_z=3.0):\n    pts = np.fromfile(path, dtype=np.float32).reshape(-1, 4)\n    x, y, z = pts[:,0], pts[:,1], pts[:,2]\n    m = (x>=x_range[0])&(x<x_range[1])&(y>=y_range[0])&(y<y_range[1])&(z<max_z)\n    x, y, z, i = x[m], y[m], z[m], pts[m,3]\n    ix = np.clip(((x-x_range[0])/(x_range[1]-x_range[0])*H).astype(int), 0, H-1)\n    iy = np.clip(((y-y_range[0])/(y_range[1]-y_range[0])*W).astype(int), 0, W-1)\n    bev = np.zeros((3, H, W), dtype=np.float32)\n    np.add.at(bev[0], (ix, iy), 1.0)           # density\n    np.maximum.at(bev[1], (ix, iy), z + 2.0)   # height\n    np.maximum.at(bev[2], (ix, iy), i)         # intensity\n    bev[0] = np.clip(bev[0]/10, 0, 1)\n    bev[1] = np.clip(bev[1]/5,  0, 1)\n    return bev\n\ndef augment_image(arr):\n    pil = Image.fromarray((arr*255).astype(np.uint8))\n    w, h = pil.size\n    s = np.random.uniform(0.5, 1.0)\n    nw, nh = max(16, int(w*s)), max(16, int(h*s))\n    x0, y0 = np.random.randint(0, w-nw+1), np.random.randint(0, h-nh+1)\n    pil = pil.crop((x0, y0, x0+nw, y0+nh)).resize((w, h), Image.BILINEAR)\n    if np.random.rand() < 0.5: pil = pil.transpose(Image.FLIP_LEFT_RIGHT)\n    if np.random.rand() < 0.8:\n        for E, a in [(ImageEnhance.Brightness,.4),(ImageEnhance.Contrast,.4),(ImageEnhance.Color,.4)]:\n            pil = E(pil).enhance(1 + (np.random.rand()*2-1)*a)\n    if np.random.rand() < 0.2: pil = pil.convert('L').convert('RGB')\n    if np.random.rand() < 0.3: pil = pil.filter(ImageFilter.GaussianBlur(np.random.uniform(0.3,1.5)))\n    return np.asarray(pil, dtype=np.float32)/255.0\n\ndef augment_bev(bev):\n    if np.random.rand() < 0.5: bev = bev[:, :, ::-1].copy()\n    if np.random.rand() < 0.3: bev = bev * np.random.uniform(0.7, 1.3)\n    mask = np.random.rand(*bev.shape) > np.random.uniform(0.05, 0.15)\n    return np.clip(bev * mask, 0, 1)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-27T21:41:07.854935Z","iopub.execute_input":"2026-04-27T21:41:07.855926Z","iopub.status.idle":"2026-04-27T21:41:07.870764Z","shell.execute_reply.started":"2026-04-27T21:41:07.855887Z","shell.execute_reply":"2026-04-27T21:41:07.869856Z"}},"outputs":[],"execution_count":4},{"cell_type":"markdown","source":"****Preview** raw data**","metadata":{}},{"cell_type":"code","source":"fig, axes = plt.subplots(4, 4, figsize=(16, 6))\nfor col in range(4):\n    idx = col * (len(common) // 4)\n    img = load_image(IMG_LIST[idx])\n    bev = load_bev(BIN_LIST[idx])\n    axes[0, col].imshow(img); axes[0, col].set_title(f'frame {idx}', fontsize=9); axes[0, col].axis('off')\n    axes[1, col].imshow(bev[0], cmap='magma', origin='lower'); axes[1, col].set_title('BEV density', fontsize=9); axes[1, col].axis('off')\n    axes[2, col].imshow(bev[1], cmap='viridis', origin='lower'); axes[2, col].set_title('BEV height', fontsize=9); axes[2, col].axis('off')\n    axes[3, col].imshow(bev[2], cmap='plasma', origin='lower'); axes[3, col].set_title('BEV intensity', fontsize=9); axes[3, col].axis('off')\nplt.suptitle('dataset frames, RGB (row 1) and LiDAR BEV channels (rows 2-4)', fontsize=12, y=1.02)\nplt.tight_layout(); plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-27T21:41:11.558242Z","iopub.execute_input":"2026-04-27T21:41:11.558924Z","iopub.status.idle":"2026-04-27T21:41:12.638976Z","shell.execute_reply.started":"2026-04-27T21:41:11.558891Z","shell.execute_reply":"2026-04-27T21:41:12.638142Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1600x600 with 16 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":5},{"cell_type":"markdown","source":"**Augmented positive pairs**","metadata":{}},{"cell_type":"code","source":"demo_img = load_image(IMG_LIST[0])\ndemo_bev = load_bev(BIN_LIST[0])\n\nfig, axes = plt.subplots(2, 5, figsize=(18, 4))\naxes[0, 0].imshow(demo_img); axes[0, 0].set_title('original', fontsize=9); axes[0, 0].axis('off')\naxes[1, 0].imshow(demo_bev[0], cmap='magma', origin='lower'); axes[1, 0].axis('off')\nfor k in range(1, 5):\n    axes[0, k].imshow(np.clip(augment_image(demo_img), 0, 1)); axes[0, k].set_title(f'img aug {k}', fontsize=9); axes[0, k].axis('off')\n    axes[1, k].imshow(np.clip(augment_bev(demo_bev)[0], 0, 1), cmap='magma', origin='lower'); axes[1, k].set_title(f'bev aug {k}', fontsize=9); axes[1, k].axis('off')\naxes[0, 0].set_ylabel('RGB', fontsize=10); axes[1, 0].set_ylabel('BEV density', fontsize=10)\nplt.suptitle('Positive pair = two independent augmentations of the same frame (contrastive training signal)', fontsize=11)\nplt.tight_layout(); plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-27T21:41:18.447768Z","iopub.execute_input":"2026-04-27T21:41:18.448564Z","iopub.status.idle":"2026-04-27T21:41:19.106540Z","shell.execute_reply.started":"2026-04-27T21:41:18.448536Z","shell.execute_reply":"2026-04-27T21:41:19.105803Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1800x400 with 10 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":6},{"cell_type":"markdown","source":"**Dataset**","metadata":{}},{"cell_type":"code","source":"class KITTITwoView(Dataset):\n    def __init__(self, img_paths, bin_paths):\n        self.imgs = img_paths\n        self.bins = bin_paths\n        print('caching...')\n        self.img_cache = [load_image(p) for p in tqdm(self.imgs, leave=False)]\n        self.bev_cache = [load_bev(p)   for p in tqdm(self.bins, leave=False)]\n\n    def __len__(self): return len(self.imgs)\n\n    def _to_t(self, arr_hw):\n        return torch.from_numpy(arr_hw).float()\n\n    def __getitem__(self, idx):\n        img, bev = self.img_cache[idx], self.bev_cache[idx]\n        # view A\n        ia = torch.from_numpy(augment_image(img)).permute(2, 0, 1)\n        ba = torch.from_numpy(np.clip(augment_bev(bev), 0, 1))\n        # view B\n        ib = torch.from_numpy(augment_image(img)).permute(2, 0, 1)\n        bb = torch.from_numpy(np.clip(augment_bev(bev), 0, 1))\n        return ia, ba, ib, bb, idx\n\nperm = np.random.default_rng(SEED).permutation(len(common))\nn_val = max(2, len(common) // 8)\nval_ids   = sorted(perm[:n_val].tolist())\ntrain_ids = sorted(perm[n_val:].tolist())\n\ntrain_ds = KITTITwoView([IMG_LIST[i] for i in train_ids], [BIN_LIST[i] for i in train_ids])\nval_ds   = KITTITwoView([IMG_LIST[i] for i in val_ids],   [BIN_LIST[i] for i in val_ids])\n\nBATCH = 32 if DEVICE.type == 'cuda' else 8\ntrain_loader = DataLoader(train_ds, batch_size=BATCH, shuffle=True,  num_workers=2, pin_memory=True)\nval_loader   = DataLoader(val_ds,   batch_size=BATCH, shuffle=False, num_workers=2, pin_memory=True)\nprint(f'train={len(train_ds)}  val={len(val_ds)}  batch={BATCH}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-27T21:41:24.038097Z","iopub.execute_input":"2026-04-27T21:41:24.038794Z","iopub.status.idle":"2026-04-27T21:45:07.963640Z","shell.execute_reply.started":"2026-04-27T21:41:24.038762Z","shell.execute_reply":"2026-04-27T21:45:07.962805Z"}},"outputs":[{"name":"stdout","text":"caching...\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"  0%|          | 0/4375 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":""}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"  0%|          | 0/4375 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":""}},"metadata":{}},{"name":"stdout","text":"caching...\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"  0%|          | 0/625 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":""}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"  0%|          | 0/625 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":""}},"metadata":{}},{"name":"stdout","text":"train=4375  val=625  batch=32\n","output_type":"stream"}],"execution_count":7},{"cell_type":"markdown","source":"**Next we set the cross-attention multimodal encoder**","metadata":{}},{"cell_type":"code","source":"def cbn(i, o, s=1):\n    return nn.Sequential(nn.Conv2d(i, o, 3, s, 1, bias=False), nn.BatchNorm2d(o), nn.GELU())\n\nclass CNNEncoder(nn.Module):\n    \"\"\"4× stride-2 CNN into spatial feature tokens.\"\"\"\n    def __init__(self, in_ch, dim=128):\n        super().__init__()\n        self.net = nn.Sequential(\n            cbn(in_ch, 32, 2), cbn(32, 32),\n            cbn(32, 64, 2),    cbn(64, 64),\n            cbn(64, dim, 2),   cbn(dim, dim),\n            cbn(dim, dim, 2),\n        )\n    def forward(self, x):\n        h = self.net(x)                           # B,dim,H',W'\n        return h.flatten(2).transpose(1, 2)       # B,N,dim\n\nclass CrossModalAttn(nn.Module):\n    \"\"\"Q from modality A gathers context from K,V of modality B.\"\"\"\n    def __init__(self, dim, heads=4):\n        super().__init__()\n        self.heads = heads; self.scale = (dim // heads) ** -0.5\n        self.qkv_a = nn.Linear(dim, dim * 3)\n        self.kv_b  = nn.Linear(dim, dim * 2)\n        self.proj  = nn.Linear(dim, dim)\n        self.norm  = nn.LayerNorm(dim)\n\n    def forward(self, a, b):\n        B, Na, C = a.shape; h = self.heads; d = C // h\n        qkv = self.qkv_a(a).reshape(B, Na, 3, h, d).permute(2, 0, 3, 1, 4)\n        q, k_a, v_a = qkv.unbind(0)                               # self-attn components\n        kv_b = self.kv_b(b).reshape(B, -1, 2, h, d).permute(2, 0, 3, 1, 4)\n        k_b, v_b = kv_b.unbind(0)                                 # cross-attn components\n        k = torch.cat([k_a, k_b], dim=2)                          # mix self + cross keys\n        v = torch.cat([v_a, v_b], dim=2)\n        attn = (q @ k.transpose(-2, -1)) * self.scale\n        attn = attn.softmax(dim=-1)\n        out = (attn @ v).transpose(1, 2).contiguous().reshape(B, Na, C)\n        return self.norm(a + self.proj(out)), attn.detach()\n\nclass MultimodalEncoder(nn.Module):\n    def __init__(self, dim=128, proj_dim=64):\n        super().__init__()\n        self.img_enc = CNNEncoder(3, dim)\n        self.bev_enc = CNNEncoder(3, dim)\n        self.fuse_img = CrossModalAttn(dim, heads=4)  # img attends to BEV\n        self.fuse_bev = CrossModalAttn(dim, heads=4)  # BEV attends to img\n        self.projector = nn.Sequential(\n            nn.Linear(dim * 2, dim), nn.BatchNorm1d(dim), nn.ReLU(inplace=True),\n            nn.Linear(dim, proj_dim),\n        )\n\n    def encode(self, img, bev):\n        xi = self.img_enc(img)                        # B,N_img,dim\n        xb = self.bev_enc(bev)                        # B,N_bev,dim\n        xi_f, attn = self.fuse_img(xi, xb)            # img gathers BEV context\n        xb_f, _    = self.fuse_bev(xb, xi)            # BEV gathers img context\n        h = torch.cat([xi_f.mean(1), xb_f.mean(1)], dim=-1)  # B, 2*dim\n        return h, attn                                # (features, attn for viz)\n\n    def forward(self, img, bev):\n        h, attn = self.encode(img, bev)\n        return F.normalize(self.projector(h), dim=-1), attn\n\nmodel = MultimodalEncoder().to(DEVICE)\nnparams = sum(p.numel() for p in model.parameters())\nprint(f'params: {nparams/1e6:.2f} M')\n\nia_t, ba_t, ib_t, bb_t, _ = next(iter(train_loader))\nwith torch.no_grad():\n    z, attn = model(ia_t.to(DEVICE), ba_t.to(DEVICE))\nN_img = IMG_H // 16 * IMG_W // 16   # 6×20 = 120\nN_bev = BEV_H // 16 * BEV_W // 16  # 6×6  = 36\nprint(f'z shape: {tuple(z.shape)}  ||z||={z.norm(dim=-1).mean():.2f}')\nprint(f'attn shape: {tuple(attn.shape)}  (B, heads, {N_img} img_tokens, {N_img}+{N_bev} keys)')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-27T21:45:29.325687Z","iopub.execute_input":"2026-04-27T21:45:29.326309Z","iopub.status.idle":"2026-04-27T21:45:31.444245Z","shell.execute_reply.started":"2026-04-27T21:45:29.326276Z","shell.execute_reply":"2026-04-27T21:45:31.443497Z"}},"outputs":[{"name":"stdout","text":"params: 1.11 M\nz shape: (32, 64)  ||z||=1.00\nattn shape: (32, 4, 120, 156)  (B, heads, 120 img_tokens, 120+36 keys)\n","output_type":"stream"}],"execution_count":8},{"cell_type":"markdown","source":"NT-Xent training","metadata":{}},{"cell_type":"code","source":"def nt_xent(z1, z2, temp=0.2):\n    B = z1.size(0)\n    z = torch.cat([z1, z2])\n    sim = z @ z.t() / temp\n    sim.fill_diagonal_(-1e9)\n    targets = (torch.arange(2*B, device=z.device) + B) % (2*B)\n    return F.cross_entropy(sim, targets)\n\ndef alignment(z1, z2): return (z1 * z2).sum(-1).mean().item()\n\nEPOCHS = 100\nopt    = torch.optim.Adam(model.parameters(), lr=3e-4)\nsched  = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=EPOCHS)\n\nhist = {'loss': [], 'val_loss': [], 'align': []}\n\nfor epoch in tqdm(range(1, EPOCHS + 1), desc='training'):\n    model.train(); L, A = [], []\n    for ia, ba, ib, bb, _ in train_loader:\n        ia=ia.to(DEVICE); ba=ba.to(DEVICE); ib=ib.to(DEVICE); bb=bb.to(DEVICE)\n        z1, _ = model(ia, ba); z2, _ = model(ib, bb)\n        loss = nt_xent(z1, z2)\n        opt.zero_grad(); loss.backward(); opt.step()\n        L.append(loss.item()); A.append(alignment(z1.detach(), z2.detach()))\n    sched.step()\n    model.eval()\n    with torch.no_grad():\n        VL = [nt_xent(*model(ia.to(DEVICE), ba.to(DEVICE))[:1] + (model(ib.to(DEVICE), bb.to(DEVICE))[0],)).item()\n              for ia, ba, ib, bb, _ in val_loader]\n    hist['loss'].append(float(np.mean(L)))\n    hist['val_loss'].append(float(np.mean(VL)))\n    hist['align'].append(float(np.mean(A)))\n\nprint(f'final  loss={hist[\"loss\"][-1]:.3f}  align={hist[\"align\"][-1]:.3f}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-27T21:45:52.290147Z","iopub.execute_input":"2026-04-27T21:45:52.291237Z","iopub.status.idle":"2026-04-27T22:18:31.689162Z","shell.execute_reply.started":"2026-04-27T21:45:52.291200Z","shell.execute_reply":"2026-04-27T22:18:31.688216Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"training:   0%|          | 0/100 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"2f6ef039ee884b849349e4022f11b769"}},"metadata":{}},{"name":"stdout","text":"final  loss=0.373  align=0.995\n","output_type":"stream"}],"execution_count":9},{"cell_type":"code","source":"fig, axes = plt.subplots(1, 2, figsize=(12, 3.5))\naxes[0].plot(hist['loss'], label='train'); axes[0].plot(hist['val_loss'], label='val')\naxes[0].set_title('NT-Xent loss'); axes[0].set_xlabel('epoch'); axes[0].legend(); axes[0].grid(alpha=0.3)\naxes[1].plot(hist['align'], color='tab:green')\naxes[1].set_title('Positive-pair alignment (cos sim) — higher = better')\naxes[1].set_xlabel('epoch'); axes[1].grid(alpha=0.3)\nplt.tight_layout(); plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.b